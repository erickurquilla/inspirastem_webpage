h: 768px) 100vw, 768px\" \/>\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-b49e4d7 elementor-widget elementor-widget-image\" data-id=\"b49e4d7\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"image.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<img decoding=\"async\" width=\"1024\" height=\"343\" src=\"..\/..\/..\/..\/wp-content\/uploads\/2025\/10\/university-of-dundee-seeklogo-1024x343.png\" class=\"attachment-large size-large wp-image-2193\" alt=\"\" srcset=\"..\/..\/..\/..\/wp-content\/uploads\/2025\/10\/university-of-dundee-seeklogo-1024x343.png 1024w, https:\/\/inspirastem.com\/wp-content\/uploads\/2025\/10\/university-of-dundee-seeklogo-300x101.png 300w, https:\/\/inspirastem.com\/wp-content\/uploads\/2025\/10\/university-of-dundee-seeklogo-768x257.png 768w, https:\/\/inspirastem.com\/wp-content\/uploads\/2025\/10\/university-of-dundee-seeklogo-1536x515.png 1536w, ..\/..\/..\/..\/wp-content\/uploads\/2025\/10\/university-of-dundee-seeklogo.png 2000w\" sizes=\"(max-width: 1024px) 100vw, 1024px\" \/>\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-964c885 elementor-widget elementor-widget-spacer\" data-id=\"964c885\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"spacer.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t<div class=\"elementor-spacer\">\n\t\t\t<div class=\"elementor-spacer-inner\"><\/div>\n\t\t<\/div>\n\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-5782615 e-con-full e-flex e-con e-child\" data-id=\"5782615\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-44efd2f elementor-widget elementor-widget-heading\" data-id=\"44efd2f\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<h2 class=\"elementor-heading-title elementor-size-default\"><h4 data-elementor-setting-key=\"title\" data-pen-placeholder=\"Teclea aqu\u00ed...\" style=\"font-family: Roboto, sans-serif;font-weight: 600;text-transform: none;font-size: 50px;text-align: justify\">Rafael Salazar,<br><\/h4><h4 data-elementor-setting-key=\"title\" data-pen-placeholder=\"Teclea aqu\u00ed...\" style=\"font-family: Roboto, sans-serif;font-weight: 600;text-transform: none;font-size: 25px;line-height: 20px\"><i>Instructor<\/i><span style=\"font-size: 32px\"><\/span><\/h4><\/h2>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-488810c elementor-widget elementor-widget-heading\" data-id=\"488810c\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<h4 class=\"elementor-heading-title elementor-size-default\"><font color=\"#000000\" face=\"Arial, sans-serif\"><span style=\"font-size: 16px;font-weight: normal\">Rafael Enrique Salazar Claros es bioqu\u00edmico y bi\u00f3logo molecular con una s\u00f3lida formaci\u00f3n acad\u00e9mica y experiencia en investigaci\u00f3n, actualmente cursando un doctorado en Bioqu\u00edmica en la Universidad de Dundee, Reino Unido, enfocado en la regulaci\u00f3n de la respuesta inmune mediada por ISG15 durante infecciones virales y bacterianas. Posee una maestr\u00eda en Biolog\u00eda Celular y Molecular de la Universidad de Heidelberg, Alemania, y una licenciatura en Biolog\u00eda General de la Universidad de El Salvador, graduado cum laude. Rafael cuenta con amplia experiencia en bioinform\u00e1tica, acoplamiento molecular, interacciones proteicas y estudios celulares funcionales, con pasant\u00edas en el Heidelberg Institute for Theoretical Sciences y el Biochemistry Center Heidelberg, as\u00ed como trabajo de laboratorio en El Salvador. Ha contribuido a m\u00faltiples publicaciones en revistas de alto impacto y posee experiencia en t\u00e9cnicas experimentales, modelado molecular y gesti\u00f3n de laboratorio. Fluido en espa\u00f1ol e ingl\u00e9s y con dominio del alem\u00e1n, combina profundo conocimiento cient\u00edfico con habilidades pr\u00e1cticas de laboratorio y computacionales, demostrando un fuerte compromiso con el avance de la investigaci\u00f3n molecular y celular.\n<\/h4>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t","protected":false},"excerpt":{"rendered":"<p>Rafael Salazar, Instructor Rafael Enrique Salazar Claros es bioqu\u00edmico y bi\u00f3logo molecular con una s\u00f3lida formaci\u00f3n acad\u00e9mica y experiencia en investigaci\u00f3n, actualmente cursando un doctorado en Bioqu\u00edmica en la Universidad de Dundee, Reino Unido, enfocado en la regulaci\u00f3n de la respuesta inmune mediada por ISG15 durante infecciones virales y bacterianas. Posee una maestr\u00eda en Biolog\u00eda [&hellip;]<\/p>\n","protected":false},"author":1,"featured_media":0,"parent":0,"menu_order":0,"comment_status":"closed","ping_status":"closed","template":"","meta":{"footnotes":""},"class_list":["post-2167","page","type-page","status-publish"],"_links":{"self":[{"href":"https:\/\/inspirastem.com\/wp-json\/wp\/v2\/pages\/2167","targetHints":{"allow":["GET"]}}],"collection":[{"href":"."}],"about":[{"href":"https:\/\/inspirastem.com\/wp-json\/wp\/v2\/types\/page"}],"author":[{"embeddable":true,"href":"https:\/\/inspirastem.com\/wp-json\/wp\/v2\/users\/1"}],"replies":[{"embeddable":true,"href":"https:\/\/inspirastem.com\/wp-json\/wp\/v2\/comments?post=2167"}],"version-history":[{"count":28,"href":"https:\/\/inspirastem.com\/wp-json\/wp\/v2\/pages\/2167\/revisions"}],"predecessor-version":[{"id":2389,"href":"https:\/\/inspirastem.com\/wp-json\/wp\/v2\/pages\/2167\/revisions\/2389"}],"wp:attachment":[{"href":"https:\/\